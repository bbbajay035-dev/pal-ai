# PAL.AI Environment Configuration
# Copy this file to .env and fill in your API keys

# Flask/FastAPI Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///pal_ai.db

# API Port
API_PORT=5000
API_HOST=0.0.0.0

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# ============================================
# FREE API KEYS (Sign up for free tier)
# ============================================

# Twitter API v2 (Free Tier)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Hunter.io (Free Tier - 50 searches/month)
# Get from: https://hunter.io/
HUNTER_API_KEY=your_hunter_api_key_here

# NumVerify (Free Tier - phone number validation)
# Get from: https://numverify.com/
NUMVERIFY_API_KEY=your_numverify_api_key_here

# OpenCage Geocoding (Free Tier - 2,500 requests/day)
# Get from: https://opencagedata.com/
OPENCAGE_API_KEY=your_opencage_api_key_here

# IP Stack (Free Tier - 100 requests/month)
# Get from: https://ipstack.com/
IPSTACK_API_KEY=your_ipstack_api_key_here

# Abstract API - IP Geolocation (Free Tier)
# Get from: https://www.abstractapi.com/
ABSTRACT_API_KEY=your_abstract_api_key_here

# Clearbit (Free for personal use)
# Get from: https://clearbit.com/
CLEARBIT_API_KEY=your_clearbit_api_key_here

# RocketReach (Free Tier - limited)
# Get from: https://rocketreach.com/
ROCKETREACH_API_KEY=your_rocketreach_api_key_here

# Google Custom Search (Free Tier)
# Get from: https://cse.google.com/
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Crunchbase (Public data - no key needed)
CRUNCHBASE_ENABLED=true

# LinkedIn (Using public scraping - no key needed)
LINKEDIN_ENABLED=true

# ============================================
# Database Configuration
# ============================================
DB_TYPE=sqlite
DB_NAME=pal_ai.db

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/pal_ai.log

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ============================================
# Cache Configuration
# ============================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================
# Security
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOW_INTERNAL_IPS=true
MAX_REQUESTS_PER_MINUTE=60
